---
/* Shell dei giochi: un template genera le 15 pagine che prima erano
   15 index.html quasi identici mantenuti a mano. Gli engine e i dati
   dei giochi (public/giochi/) restano identici al sito attuale, così
   i salvataggi in localStorage sono preservati. La lingua la gestisce
   l'engine stesso (bottoni data-lang), quindi niente variante /en/. */
import catalogo from '../../data/giochi.json';

export function getStaticPaths() {
  return catalogo.giochi.map((g) => ({ params: { slug: g.slug }, props: { gioco: g } }));
}

const { gioco } = Astro.props;

/* Riscrive i percorsi delle shell originali (relative alla root del
   sito attuale) sui percorsi assoluti di v2. */
function riscrivi(src, slug) {
  if (src.startsWith('../giochi/')) return src.replace('../giochi/', '/giochi/');
  if (!src.includes('/')) return `/giochi/${slug}/${src}`;
  return src;
}
const scripts = gioco.scripts.map((s) => riscrivi(s, gioco.slug));
const stylesheets = gioco.stylesheets.map((s) => riscrivi(s, gioco.slug));
const canonical = new URL(`/giochi/${gioco.slug}/`, Astro.site);
---

<html lang="it">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="color-scheme" content="dark light" />
    <meta name="theme-color" content="#0d0b1a" id="metaThemeColor" />
    <meta name="description" content={gioco.meta_desc?.it ?? gioco.it.tagline} />
    <title>{gioco.title_head}</title>
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={gioco.title_head} />
    <meta property="og:description" content={gioco.meta_desc?.it ?? gioco.it.tagline} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/og-image.jpg', Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>
      (function () {
        try {
          if (localStorage.getItem('sctheme') === 'light') {
            document.documentElement.setAttribute('data-theme', 'light');
            var m = document.getElementById('metaThemeColor');
            if (m) m.setAttribute('content', '#f5f0e8');
          }
          var lg = localStorage.getItem('sc-lang');
          document.documentElement.setAttribute('lang', lg === 'en' ? 'en' : 'it');
        } catch (e) {}
      })();
    </script>
    {stylesheets.map((href) => <link rel="stylesheet" href={href} />)}
  </head>
  <body>
    <template id="__bundler_thumbnail">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"
        ><rect width="100" height="100" fill="#0d0b1a"></rect><circle
          cx="50"
          cy="50"
          r="20"
          fill="none"
          stroke="#c9973a"
          stroke-width="1.4"></circle><circle cx="50" cy="50" r="5" fill="#e8c97a"></circle></svg
      >
    </template>
    <header class="topbar">
      <a class="brand" id="brandLink" href="/" title="Torna al sito">
        <span class="brand-seal" aria-hidden="true">✶</span>
        <span class="brand-text"
          ><span class="brand-school" id="brandSchool">Scuola ContattaTi</span></span
        >
      </a>
      <div class="topbar-right">
        <a class="games-link" href="/giochi/" id="gamesLink">Giochi</a>
        <span class="lang-pill" role="group" aria-label="Lingua / Language">
          <button type="button" data-lang="it" class="active">IT</button>
          <span class="lang-dot">·</span>
          <button type="button" data-lang="en">EN</button>
        </span>
        <button class="theme-toggle" id="themeToggle" type="button" aria-label="Cambia tema">
          <span class="ico" aria-hidden="true">☀</span><span class="lbl">Tema chiaro</span>
        </button>
      </div>
    </header>
    <main class="stage"><div id="app"></div></main>
    {scripts.map((src) => <script is:inline src={src} />)}
  </body>
</html>
