---
import '../styles/base.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieBanner from '../components/CookieBanner.astro';
import { t, altPath } from '../i18n/strings.js';

const { locale = 'it', title, description } = Astro.props;
const S = t(locale);
const pathname = Astro.url.pathname;
const itHref = altPath(pathname, 'it');
const enHref = altPath(pathname, 'en');
---

<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="color-scheme" content="dark light" />
    <meta name="theme-color" content="#0d0b1a" id="metaThemeColor" />
    <title>{title ? `${title} · ${S.schoolName}` : `${S.schoolName} · ${S.tagline}`}</title>
    {description && <meta name="description" content={description} />}
    <link rel="alternate" hreflang="it" href={new URL(itHref, Astro.site)} />
    <link rel="alternate" hreflang="en" href={new URL(enHref, Astro.site)} />
    <link rel="alternate" hreflang="x-default" href={new URL(itHref, Astro.site)} />
    <link rel="canonical" href={new URL(pathname, Astro.site)} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link
      rel="preload"
      href="/fonts/eb-garamond-latin-600-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/inter-latin-400-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <!-- Anti-flash: applica il tema salvato prima del render -->
    <script is:inline>
      (function () {
        try {
          if (localStorage.getItem('sctheme') === 'light') {
            document.documentElement.setAttribute('data-theme', 'light');
            var m = document.getElementById('metaThemeColor');
            if (m) m.setAttribute('content', '#f6f2ea');
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <Header locale={locale} itHref={itHref} enHref={enHref} />
    <main id="main">
      <slot />
    </main>
    <Footer locale={locale} />
    <CookieBanner locale={locale} />
  </body>
</html>
