---
import '../styles/base.css';
import Header from '../components/Header.astro';
import { t, altPath } from '../i18n/strings.js';

const { locale = 'it', title, description } = Astro.props;
const S = t(locale);
const pathname = Astro.url.pathname;
const itHref = altPath(pathname, 'it');
const enHref = altPath(pathname, 'en');
---

<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="color-scheme" content="dark light" />
    <meta name="theme-color" content="#0d0b1a" id="metaThemeColor" />
    <title>{title ? `${title} · ${S.schoolName}` : `${S.schoolName} · ${S.tagline}`}</title>
    {description && <meta name="description" content={description} />}
    <link rel="alternate" hreflang="it" href={new URL(itHref, Astro.site)} />
    <link rel="alternate" hreflang="en" href={new URL(enHref, Astro.site)} />
    <link rel="alternate" hreflang="x-default" href={new URL(itHref, Astro.site)} />
    <link
      rel="preload"
      href="/fonts/eb-garamond-latin-600-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/inter-latin-400-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <!-- Anti-flash: applica il tema salvato prima del render -->
    <script is:inline>
      (function () {
        try {
          if (localStorage.getItem('sctheme') === 'light') {
            document.documentElement.setAttribute('data-theme', 'light');
            var m = document.getElementById('metaThemeColor');
            if (m) m.setAttribute('content', '#f6f2ea');
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <Header locale={locale} itHref={itHref} enHref={enHref} />
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container">
        <p class="muted">{S.footerNote}</p>
      </div>
    </footer>
  </body>
</html>

<style>
  .site-footer {
    border-top: 1px solid var(--border);
    padding-block: var(--space-3);
    margin-top: var(--space-5);
    font-size: 0.85rem;
  }
</style>
