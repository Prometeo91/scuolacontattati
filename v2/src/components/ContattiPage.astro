---
import Base from '../layouts/Base.astro';
import { t } from '../i18n/strings.js';
import contatti from '../data/contatti.json';

const { locale } = Astro.props;
const S = t(locale);
const T = contatti.sezione[locale] ?? contatti.sezione.it;
const form = contatti.form;
const privacy = form.privacy[locale] ?? form.privacy.it;

const ICONE = { whatsapp: '✆', email: '✉', facebook: 'f', telefono: '☏' };

/* L'email è ricomposta via JS come nel sito attuale (anti-spam):
   nel markup statico non compare mai per intero. */
const [emailUser, emailDomain] = 'scuola-contattati@libero.it'.split('@');
const canali = contatti.canali.filter((c) => c.tipo !== 'email');

const INVIA = { it: 'Invia il messaggio', en: 'Send message' };
---

<Base locale={locale} title={T.titolo} description={T.sottotitolo}>
  <section class="section container">
    <p class="eyebrow">{T.eyebrow}</p>
    <h1>{T.titolo}</h1>
    <p class="sottotitolo">{T.sottotitolo}</p>

    <div class="canali">
      {
        canali.map((c) => (
          <a
            class="card canale"
            href={c.url}
            target={c.url.startsWith('http') ? '_blank' : undefined}
            rel={c.url.startsWith('http') ? 'noopener' : undefined}
          >
            <span class="icona" aria-hidden="true">
              {ICONE[c.tipo] ?? '·'}
            </span>
            <span>
              <strong>{c.etichetta}</strong>
              <br />
              <span class="muted">{c.valore}</span>
            </span>
          </a>
        ))
      }
      <a class="card canale" id="email-card" href="#">
        <span class="icona" aria-hidden="true">✉</span>
        <span>
          <strong>Email</strong><br />
          <span class="muted" id="email-display" data-u={emailUser} data-d={emailDomain}></span>
        </span>
      </a>
    </div>

    <form class="card contatti-form" action={form.action} method={form.method}>
      {
        form.campi.map((campo) => {
          const C = campo[locale] ?? campo.it;
          return (
            <label>
              <span>{C.label}</span>
              {campo.tipo === 'textarea' ? (
                <textarea
                  name={campo.name}
                  required={campo.obbligatorio}
                  placeholder={C.placeholder}
                  rows="5"
                />
              ) : (
                <input
                  type={campo.tipo}
                  name={campo.name}
                  required={campo.obbligatorio}
                  placeholder={C.placeholder}
                />
              )}
            </label>
          );
        })
      }
      <input type="text" name={form.honeypot} tabindex="-1" autocomplete="off" class="hp" aria-hidden="true" />
      <label class="consenso">
        <input type="checkbox" required />
        <span>{privacy.consenso}</span>
      </label>
      <details class="informativa">
        <summary>{privacy.summary}</summary>
        <div set:html={privacy.informativa} />
      </details>
      <button class="btn" type="submit">{INVIA[locale] ?? INVIA.it}</button>
    </form>

    <p class="muted footer-dati">
      {contatti.indirizzo}<br />
      {contatti.titolare}
    </p>
  </section>

  <script>
    const el = document.getElementById('email-display');
    const addr = el.dataset.u + '@' + el.dataset.d;
    el.textContent = addr;
    document.getElementById('email-card').setAttribute('href', 'mailto:' + addr);
  </script>

  <style>
    .sottotitolo {
      font-size: 1.1rem;
      color: var(--text-2);
    }
    .canali {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
      gap: var(--space-2);
      margin-block: var(--space-3);
    }
    .canale {
      display: flex;
      align-items: center;
      gap: var(--space-2);
      color: inherit;
    }
    .canale:hover {
      text-decoration: none;
    }
    .icona {
      font-size: 1.5rem;
      color: var(--accent);
    }
    .contatti-form {
      max-width: var(--measure);
      display: grid;
      gap: var(--space-2);
    }
    .contatti-form label {
      display: grid;
      gap: 0.3rem;
      font-size: 0.9rem;
      color: var(--text-2);
    }
    .contatti-form input,
    .contatti-form textarea {
      font: inherit;
      background: var(--bg);
      color: var(--text);
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 0.6rem 0.8rem;
    }
    .contatti-form input:focus,
    .contatti-form textarea:focus {
      outline: none;
      border-color: var(--accent-2);
    }
    .hp {
      position: absolute;
      left: -5000px;
    }
    .consenso {
      display: flex !important;
      flex-direction: row;
      align-items: start;
      gap: 0.6rem !important;
    }
    .informativa {
      font-size: 0.85rem;
      color: var(--text-3);
    }
    .informativa summary {
      cursor: pointer;
      color: var(--accent-2);
    }
    .informativa :global(p) {
      margin-top: 0.6rem;
    }
    .contatti-form .btn {
      justify-self: start;
      cursor: pointer;
      font: inherit;
      background: none;
    }
    [data-theme='light'] .contatti-form .btn {
      background: var(--accent);
    }
    .footer-dati {
      margin-top: var(--space-3);
      font-size: 0.85rem;
    }
  </style>
</Base>
