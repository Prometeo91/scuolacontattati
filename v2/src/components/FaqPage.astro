---
import Base from '../layouts/Base.astro';
import { t } from '../i18n/strings.js';
import faq from '../data/faq.json';

const { locale } = Astro.props;
const S = t(locale);
const T = faq.sezione[locale] ?? faq.sezione.it;
const voci = faq.faq.map((v) => v[locale] ?? v.it);

/* JSON-LD FAQPage per i risultati ricchi di Google */
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: voci.map((v) => ({
    '@type': 'Question',
    name: v.q,
    acceptedAnswer: { '@type': 'Answer', text: v.a.replace(/<[^>]+>/g, ' ').trim() },
  })),
};
---

<Base locale={locale} title={S.navFaq} description={T.sottotitolo}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <section class="section container">
    <p class="eyebrow">{T.eyebrow}</p>
    <h1>{T.titolo}</h1>
    <p class="muted">{T.sottotitolo}</p>

    <div class="faq-list">
      {
        voci.map((v) => (
          <details class="card">
            <summary>{v.q}</summary>
            <div class="risposta" set:html={v.a} />
          </details>
        ))
      }
    </div>
  </section>

  <style>
    .faq-list {
      display: grid;
      gap: var(--space-2);
      margin-top: var(--space-3);
      max-width: var(--measure);
    }
    summary {
      font-family: var(--font-display);
      font-size: 1.15rem;
      font-weight: 500;
      cursor: pointer;
      color: var(--text);
      list-style-position: outside;
    }
    summary:hover {
      color: var(--accent);
    }
    .risposta {
      margin-top: var(--space-2);
      color: var(--text-2);
    }
    .risposta :global(strong) {
      color: var(--accent);
    }
  </style>
</Base>
