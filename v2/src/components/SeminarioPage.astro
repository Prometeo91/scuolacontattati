---
import Base from '../layouts/Base.astro';
import seminario from '../data/seminario.json';

const { locale } = Astro.props;
const T = seminario[locale] ?? seminario.it;
---

<Base locale={locale} title={T.titolo} description={T.sottotitolo}>
  <section class="section container">
    <p class="eyebrow">{T.eyebrow}</p>
    <h1>{T.titolo}</h1>
    <p class="sottotitolo">{T.sottotitolo}</p>

    {
      seminario.eventi.map((evento) => {
        const E = evento[locale] ?? evento.it;
        const concluso = new Date(evento.expires) < new Date();
        return (
          <article class="card evento">
            <div class="evento-testo">
              <p class="eyebrow">
                {concluso ? E.countdown_labels.concluso : E.countdown_labels.tag}
              </p>
              <h2>{E.titolo}</h2>
              <p class="evento-sub">{E.sottotitolo}</p>
              <p class="muted">
                {E.data} · {E.luogo}
              </p>
              <ul class="domande">
                {E.domande.map((domanda) => (
                  <li>{domanda}</li>
                ))}
              </ul>
              <p>{E.testo}</p>
              <ul class="prezzi">
                {E.prezzi.map((prezzo) => (
                  <li set:html={prezzo} />
                ))}
              </ul>
              {!concluso && (
                <a class="btn" href={evento.cta_url} target="_blank" rel="noopener">
                  {E.cta_label}
                </a>
              )}
            </div>
            <a href={'/' + evento.immagine} target="_blank" title={E.immagine_title}>
              <img
                class="locandina"
                src={'/' + evento.immagine}
                alt={E.immagine_alt}
                loading="lazy"
              />
            </a>
          </article>
        );
      })
    }
  </section>

  <style>
    .sottotitolo {
      font-size: 1.1rem;
      color: var(--text-2);
    }
    .evento {
      display: grid;
      grid-template-columns: 1.4fr 1fr;
      gap: var(--space-3);
      margin-top: var(--space-3);
      align-items: start;
    }
    @media (max-width: 44rem) {
      .evento {
        grid-template-columns: 1fr;
      }
    }
    .evento-sub {
      font-family: var(--font-display);
      font-style: italic;
      font-size: 1.15rem;
      color: var(--text-2);
    }
    .domande {
      padding-left: 1.2rem;
      color: var(--text-2);
    }
    .domande li {
      margin-bottom: 0.3rem;
    }
    .prezzi {
      list-style: none;
      padding: 0;
      margin: var(--space-2) 0;
    }
    .prezzi li {
      margin-bottom: 0.25rem;
    }
    .prezzi :global(strong) {
      color: var(--accent);
    }
    .locandina {
      width: 100%;
      border-radius: var(--radius);
      border: 1px solid var(--border);
    }
  </style>
</Base>
