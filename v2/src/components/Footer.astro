---
import { t, localePath } from '../i18n/strings.js';

const { locale } = Astro.props;
const S = t(locale);
const p = (path) => localePath(locale, path);

const nav = [
  [p('/chi-siamo/'), S.navSchool],
  [p('/lezioni/'), S.navLessons],
  [p('/calendario/'), S.navCalendar],
  [p('/libro/'), S.navBook],
  [p('/giochi/'), S.navGames],
  [p('/faq/'), S.navFaq],
  [p('/ispirazioni/'), S.navInspirations],
  [p('/contatti/'), S.navContacts],
  [locale === 'en' ? '/en/privacy.html' : '/privacy.html', S.navPrivacy],
];
---

<footer class="site-footer">
  <div class="container">
    <nav class="footer-nav" aria-label="footer">
      {nav.map(([href, label]) => <a href={href}>{label}</a>)}
      <a href="#" id="manageCookies">{S.manageCookies}</a>
    </nav>

    <div class="footer-social">
      <a
        href="https://www.facebook.com/nicolaosanifantis"
        target="_blank"
        rel="noopener"
        aria-label="Facebook"
        ><svg class="icon-svg" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"
          ><path
            d="M22 12c0-5.52-4.48-10-10-10S2 6.48 2 12c0 4.99 3.66 9.12 8.44 9.88v-6.99H7.9V12h2.54V9.8c0-2.5 1.49-3.89 3.78-3.89 1.09 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56V12h2.78l-.44 2.89h-2.34v6.99C18.34 21.12 22 16.99 22 12z"
          ></path></svg
        ></a
      >
      <a href="tel:+393349991888" aria-label="Telefono"
        ><svg class="icon-svg" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"
          ><path
            d="M6.62 10.79a15.05 15.05 0 006.59 6.59l2.2-2.2a1 1 0 011.01-.24 11.36 11.36 0 003.58.57 1 1 0 011 1V20a1 1 0 01-1 1A17 17 0 013 4a1 1 0 011-1h3.5a1 1 0 011 1c0 1.25.2 2.45.57 3.57a1 1 0 01-.25 1.02l-2.2 2.2z"
          ></path></svg
        ></a
      >
      <a href="https://wa.me/393349991888" target="_blank" rel="noopener" aria-label="WhatsApp"
        ><svg class="icon-svg" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"
          ><path
            d="M12 2a10 10 0 00-8.6 14.9L2 22l5.2-1.4A10 10 0 1012 2zm0 18a8 8 0 01-4.1-1.1l-.3-.2-3.1.8.8-3-.2-.3A8 8 0 1112 20zm4.4-5.9c-.2-.1-1.4-.7-1.6-.8-.2-.1-.4-.1-.5.1-.2.2-.6.8-.8 1-.1.1-.3.2-.5.1-.2-.1-1-.4-1.9-1.2-.7-.6-1.2-1.4-1.3-1.6-.1-.2 0-.4.1-.5l.4-.4c.1-.1.2-.3.2-.4.1-.2 0-.3 0-.4-.1-.1-.5-1.3-.7-1.8-.2-.5-.4-.4-.5-.4h-.5c-.2 0-.4.1-.6.3-.2.2-.8.8-.8 1.9s.8 2.2.9 2.3c.1.2 1.6 2.4 3.8 3.4.5.2 1 .4 1.3.5.6.2 1.1.1 1.5.1.5-.1 1.4-.6 1.6-1.1.2-.6.2-1 .1-1.1-.1-.1-.3-.2-.5-.3z"
          ></path></svg
        ></a
      >
    </div>

    <hr class="footer-divider" />
    <p class="footer-tel"><a href="tel:+393349991888">334 999 1888</a></p>
    <p class="footer-quote">{S.footerQuote}</p>
    <p class="footer-copyright">{S.footerCopyright}</p>
  </div>
</footer>

<!-- WhatsApp sticky (mobile) -->
<a
  class="wa-sticky"
  href="https://wa.me/393349991888"
  target="_blank"
  rel="noopener"
  aria-label={locale === 'en' ? 'Message us on WhatsApp' : 'Scrivici su WhatsApp'}
>
  <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false"
    ><path
      d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347zM12.05 21.785h-.01a9.84 9.84 0 01-5.016-1.373l-.36-.214-3.73.978.996-3.635-.235-.374A9.86 9.86 0 012.166 12c0-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884zm8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"
    ></path></svg
  >
</a>

<style>
  .site-footer {
    border-top: 1px solid var(--border);
    padding-block: var(--space-4) var(--space-3);
    margin-top: var(--space-5);
    text-align: center;
    font-size: 0.85rem;
  }
  .footer-nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.4rem 1.2rem;
    margin-bottom: var(--space-3);
  }
  .footer-nav a {
    color: var(--text-2);
  }
  .footer-nav a:hover {
    color: var(--accent);
  }
  .footer-social {
    display: flex;
    justify-content: center;
    gap: var(--space-2);
    margin-bottom: var(--space-3);
  }
  .icon-svg {
    width: 1.4rem;
    height: 1.4rem;
    fill: var(--text-3);
    transition: fill var(--transition);
  }
  .footer-social a:hover .icon-svg {
    fill: var(--accent);
  }
  .footer-divider {
    border: none;
    border-top: 1px solid var(--border);
    margin-bottom: var(--space-2);
  }
  .footer-tel {
    margin-bottom: var(--space-1);
  }
  .footer-quote {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.05rem;
    color: var(--text-2);
    max-width: none;
  }
  .footer-copyright {
    color: var(--text-3);
    margin: 0;
  }
  .footer-quote,
  .footer-tel {
    margin-inline: auto;
  }
  .wa-sticky {
    display: none;
  }
  @media (max-width: 48rem) {
    .wa-sticky {
      display: flex;
      align-items: center;
      justify-content: center;
      position: fixed;
      right: 1rem;
      bottom: 1rem;
      width: 3.2rem;
      height: 3.2rem;
      border-radius: 50%;
      background: #25d366;
      z-index: 90;
      box-shadow: 0 4px 14px rgba(0, 0, 0, 0.3);
    }
    .wa-sticky svg {
      width: 1.8rem;
      height: 1.8rem;
      fill: #fff;
    }
  }
</style>
