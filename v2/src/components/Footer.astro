---
import { t, localePath } from '../i18n/strings.js';

const { locale } = Astro.props;
const S = t(locale);
const p = (path) => localePath(locale, path);

const nav = [
  [p('/chi-siamo/'), S.navSchool],
  [p('/lezioni/'), S.navLessons],
  [p('/calendario/'), S.navCalendar],
  [p('/libro/'), S.navBook],
  ['/giochi/', S.navGames],
  [p('/faq/'), S.navFaq],
  [p('/ispirazioni/'), S.navInspirations],
  [p('/contatti/'), S.navContacts],
  [locale === 'en' ? '/en/privacy.html' : '/privacy.html', S.navPrivacy],
];
---

<footer class="site-footer">
  <div class="container">
    <nav class="footer-nav" aria-label="footer">
      {nav.map(([href, label]) => <a href={href}>{label}</a>)}
      <a href="#" id="manageCookies">{S.manageCookies}</a>
    </nav>

    <div class="footer-social">
      <a
        href="https://www.facebook.com/nicolaosanifantis"
        target="_blank"
        rel="noopener"
        aria-label="Facebook"
        ><svg class="icon-svg" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"
          ><path
            d="M22 12c0-5.52-4.48-10-10-10S2 6.48 2 12c0 4.99 3.66 9.12 8.44 9.88v-6.99H7.9V12h2.54V9.8c0-2.5 1.49-3.89 3.78-3.89 1.09 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56V12h2.78l-.44 2.89h-2.34v6.99C18.34 21.12 22 16.99 22 12z"
          ></path></svg
        ></a
      >
      <a href="tel:+393349991888" aria-label="Telefono"
        ><svg class="icon-svg" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"
          ><path
            d="M6.62 10.79a15.05 15.05 0 006.59 6.59l2.2-2.2a1 1 0 011.01-.24 11.36 11.36 0 003.58.57 1 1 0 011 1V20a1 1 0 01-1 1A17 17 0 013 4a1 1 0 011-1h3.5a1 1 0 011 1c0 1.25.2 2.45.57 3.57a1 1 0 01-.25 1.02l-2.2 2.2z"
          ></path></svg
        ></a
      >
      <a href="https://wa.me/393349991888" target="_blank" rel="noopener" aria-label="WhatsApp"
        ><svg class="icon-svg" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"
          ><path
            d="M12 2a10 10 0 00-8.6 14.9L2 22l5.2-1.4A10 10 0 1012 2zm0 18a8 8 0 01-4.1-1.1l-.3-.2-3.1.8.8-3-.2-.3A8 8 0 1112 20zm4.4-5.9c-.2-.1-1.4-.7-1.6-.8-.2-.1-.4-.1-.5.1-.2.2-.6.8-.8 1-.1.1-.3.2-.5.1-.2-.1-1-.4-1.9-1.2-.7-.6-1.2-1.4-1.3-1.6-.1-.2 0-.4.1-.5l.4-.4c.1-.1.2-.3.2-.4.1-.2 0-.3 0-.4-.1-.1-.5-1.3-.7-1.8-.2-.5-.4-.4-.5-.4h-.5c-.2 0-.4.1-.6.3-.2.2-.8.8-.8 1.9s.8 2.2.9 2.3c.1.2 1.6 2.4 3.8 3.4.5.2 1 .4 1.3.5.6.2 1.1.1 1.5.1.5-.1 1.4-.6 1.6-1.1.2-.6.2-1 .1-1.1-.1-.1-.3-.2-.5-.3z"
          ></path></svg
        ></a
      >
    </div>

    <hr class="footer-divider" />
    <p class="footer-tel"><a href="tel:+393349991888">334 999 1888</a></p>
    <p class="footer-quote">{S.footerQuote}</p>
    <p class="footer-copyright">{S.footerCopyright}</p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--border);
    padding-block: var(--space-4) var(--space-3);
    margin-top: var(--space-5);
    text-align: center;
    font-size: 0.85rem;
  }
  .footer-nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.4rem 1.2rem;
    margin-bottom: var(--space-3);
  }
  .footer-nav a {
    color: var(--text-2);
  }
  .footer-nav a:hover {
    color: var(--accent);
  }
  .footer-social {
    display: flex;
    justify-content: center;
    gap: var(--space-2);
    margin-bottom: var(--space-3);
  }
  .icon-svg {
    width: 1.4rem;
    height: 1.4rem;
    fill: var(--text-3);
    transition: fill var(--transition);
  }
  .footer-social a:hover .icon-svg {
    fill: var(--accent);
  }
  .footer-divider {
    border: none;
    border-top: 1px solid var(--border);
    margin-bottom: var(--space-2);
  }
  .footer-tel {
    margin-bottom: var(--space-1);
  }
  .footer-quote {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.05rem;
    color: var(--text-2);
    max-width: none;
  }
  .footer-copyright {
    color: var(--text-3);
    margin: 0;
  }
  .footer-quote,
  .footer-tel {
    margin-inline: auto;
  }
</style>
