---
/* Banner GDPR/ePrivacy + Google Analytics con Consent Mode v2.
   Stessa logica del sito attuale: GA si carica solo dopo consenso
   esplicito (localStorage 'sc-cookie'), IP anonimizzato. */
const { locale } = Astro.props;

const TESTI = {
  it: {
    titolo: 'Privacy & cookie',
    desc: `Questo sito usa <strong>Google Analytics</strong> per capire in forma anonima e aggregata come viene navigato.
    Nessun dato personale è venduto o condiviso a fini commerciali. Puoi accettare o rifiutare;
    in entrambi i casi il sito funziona normalmente. <a href="/privacy.html">Leggi l'informativa completa</a>.`,
    rifiuta: 'Rifiuta',
    accetta: 'Accetto',
  },
  en: {
    titolo: 'Privacy & cookie',
    desc: `This site uses <strong>Google Analytics</strong> to understand in anonymous and aggregated form how it is navigated.
    No personal data is sold or shared for commercial purposes. You can accept or decline;
    in both cases the site works normally. <a href="/en/privacy.html">Read the full privacy notice</a>.`,
    rifiuta: 'Decline',
    accetta: 'Accept',
  },
};
const T = TESTI[locale] ?? TESTI.it;
---

<div
  id="cookie-banner"
  class="cookie-banner"
  role="dialog"
  aria-labelledby="cookie-title"
  aria-describedby="cookie-desc"
  hidden
>
  <p id="cookie-title" class="cookie-banner-title">{T.titolo}</p>
  <p id="cookie-desc" set:html={T.desc} />
  <div class="cookie-actions">
    <button type="button" id="cookieReject" class="cookie-btn">{T.rifiuta}</button>
    <button type="button" id="cookieAccept" class="cookie-btn cookie-btn-accept">{T.accetta}</button>
  </div>
</div>

<script is:inline>
  (function () {
    window.dataLayer = window.dataLayer || [];
    function gtag() {
      dataLayer.push(arguments);
    }
    gtag('consent', 'default', {
      ad_storage: 'denied',
      ad_user_data: 'denied',
      ad_personalization: 'denied',
      analytics_storage: 'denied',
      functionality_storage: 'granted',
      security_storage: 'granted',
      wait_for_update: 500,
    });
    function caricaGA() {
      gtag('consent', 'update', { analytics_storage: 'granted' });
      var s = document.createElement('script');
      s.async = true;
      s.src = 'https://www.googletagmanager.com/gtag/js?id=G-2NTMVVV5GB';
      document.head.appendChild(s);
      gtag('js', new Date());
      gtag('config', 'G-2NTMVVV5GB', { anonymize_ip: true });
    }
    var scelta = null;
    try {
      scelta = localStorage.getItem('sc-cookie');
    } catch (e) {}
    var banner = document.getElementById('cookie-banner');
    if (scelta === 'accept') caricaGA();
    else if (scelta !== 'reject') banner.hidden = false;

    function scegli(valore) {
      try {
        localStorage.setItem('sc-cookie', valore);
      } catch (e) {}
      banner.hidden = true;
      if (valore === 'accept') caricaGA();
    }
    document.getElementById('cookieAccept').addEventListener('click', function () {
      scegli('accept');
    });
    document.getElementById('cookieReject').addEventListener('click', function () {
      scegli('reject');
    });
    var gestisci = document.getElementById('manageCookies');
    if (gestisci)
      gestisci.addEventListener('click', function (e) {
        e.preventDefault();
        banner.hidden = false;
      });
  })();
</script>

<style>
  .cookie-banner {
    position: fixed;
    inset-inline: var(--space-2);
    bottom: var(--space-2);
    max-width: 26rem;
    margin-inline: auto;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: var(--space-2) var(--space-3);
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.35);
    z-index: 100;
    font-size: 0.85rem;
  }
  .cookie-banner-title {
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 600;
    margin-bottom: 0.4rem;
  }
  .cookie-banner p {
    color: var(--text-2);
    margin-bottom: 0.6rem;
  }
  .cookie-actions {
    display: flex;
    gap: var(--space-1);
    justify-content: flex-end;
  }
  .cookie-btn {
    font: inherit;
    padding: 0.4rem 1rem;
    border-radius: var(--radius);
    border: 1px solid var(--border);
    background: none;
    color: var(--text-2);
    cursor: pointer;
    transition: border-color var(--transition);
  }
  .cookie-btn:hover {
    border-color: var(--accent-2);
  }
  .cookie-btn-accept {
    border-color: var(--accent-2);
    color: var(--accent);
  }
  [data-theme='light'] .cookie-btn-accept {
    background: var(--accent);
    color: var(--bg);
  }
</style>
