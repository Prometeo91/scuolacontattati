---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { t, formatDate, localePath } from '../i18n/strings.js';

const { locale, lezione } = Astro.props;
const S = t(locale);
const { Content } = await render(lezione);
const d = lezione.data;
---

<Base locale={locale} title={d.titolo} description={d.sottotitolo}>
  <article class="section container">
    <a class="back" href={localePath(locale, '/lezioni/')}>{S.backToLessons}</a>
    <p class="eyebrow">
      {S.year}
      {d.anno} · {S.lesson}
      {d.num}{d.data && <> · {formatDate(d.data, locale)}</>}
    </p>
    <h1>{d.titolo}</h1>
    <p class="subtitle">{d.sottotitolo}</p>

    <div class="prose">
      <Content />
    </div>

    <section class="card themes">
      <h2>{S.themes}</h2>
      <ul>
        {d.temi.map((tema) => <li>{tema}</li>)}
      </ul>
    </section>

    {
      d.citazione && (
        <blockquote>
          {d.citazione}
          {d.autore && <footer>— {d.autore}</footer>}
        </blockquote>
      )
    }
  </article>
</Base>

<style>
  .back {
    display: inline-block;
    font-size: 0.9rem;
    margin-bottom: var(--space-3);
  }
  .subtitle {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.2rem;
    color: var(--text-2);
  }
  .prose {
    margin-top: var(--space-3);
  }
  .prose :global(p) {
    max-width: var(--measure);
  }
  .prose :global(strong) {
    color: var(--accent);
    font-weight: 600;
  }
  .themes {
    margin-top: var(--space-3);
    max-width: var(--measure);
  }
  .themes h2 {
    font-size: 1.1rem;
  }
  .themes ul {
    margin: 0;
    padding-left: 1.2rem;
    columns: 2;
    column-gap: var(--space-3);
  }
  .themes li {
    margin-bottom: 0.4rem;
    break-inside: avoid;
    color: var(--text-2);
  }
  @media (max-width: 40rem) {
    .themes ul {
      columns: 1;
    }
  }
</style>
