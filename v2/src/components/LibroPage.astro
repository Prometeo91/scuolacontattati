---
import Base from '../layouts/Base.astro';
import { t, formatDate } from '../i18n/strings.js';
import libro from '../data/libro.json';
import eventi from '../data/eventi.json';

const { locale } = Astro.props;
const S = t(locale);
const T = libro[locale] ?? libro.it;
const contenutiT = libro.contenuti[locale] ?? libro.contenuti.it;
const treT = libro.tre_definizioni[locale] ?? libro.tre_definizioni.it;
const ottoT = libro.otto_forme[locale] ?? libro.otto_forme.it;
const presT = libro.presentazioni[locale] ?? libro.presentazioni.it;

const presentazioni = eventi
  .map((e) => ({ ...e, data: new Date(e.year, e.month - 1, e.day) }))
  .sort((a, b) => b.data - a.data);
---

<Base locale={locale} title={libro.titolo} description={T.sottotitolo_sezione}>
  <section class="section container">
    <p class="eyebrow">{T.eyebrow}</p>
    <h1>{T.titolo_sezione}</h1>
    <p class="sottotitolo">{T.sottotitolo_sezione}</p>

    <div class="libro-hero">
      <img
        class="copertina"
        src={'/' + libro.copertina}
        alt={T.copertina_alt}
        loading="lazy"
      />
      <div>
        <h2>{libro.titolo}</h2>
        <p class="evento-sub">{T.sottotitolo_libro}</p>
        <p class="muted">{libro.autori} · {libro.editore}</p>
        <p set:html={T.descrizione} />
        <blockquote>
          {T.citazione}
          <footer>— {T.citazione_autori}</footer>
        </blockquote>
        <ul class="dove">
          {T.dove.map((riga) => <li set:html={riga} />)}
        </ul>
      </div>
    </div>

    <section class="blocco">
      <p class="eyebrow">{contenutiT.eyebrow}</p>
      <div class="cards-3">
        {
          libro.contenuti.card.map((card) => {
            const C = card[locale] ?? card.it;
            return (
              <div class="card">
                <p class="numero">{card.num}</p>
                <h3>{C.label}</h3>
                <p class="muted">{C.desc}</p>
              </div>
            );
          })
        }
      </div>
    </section>

    <section class="blocco">
      <p class="eyebrow">{treT.eyebrow}</p>
      <div class="cards-3">
        {
          libro.tre_definizioni.voci.map((voce) => {
            const V = voce[locale] ?? voce.it;
            return (
              <div class="card">
                <h3>{V.titolo}</h3>
                <p class="muted" set:html={V.testo} />
              </div>
            );
          })
        }
      </div>
    </section>

    <section class="blocco card">
      <p class="eyebrow">{ottoT.eyebrow}</p>
      <p set:html={ottoT.intro} />
      <ol class="otto">
        {ottoT.forme.map((forma) => <li>{forma}</li>)}
      </ol>
    </section>

    <section class="blocco">
      <p class="eyebrow">{presT.titolo}</p>
      <p class="muted">{presT.conteggio}</p>
      <ol class="presentazioni">
        {
          presentazioni.map((e) => (
            <li class="card">
              <p class="eyebrow">{formatDate(e.data, locale)}</p>
              <h3>{(e[locale] ?? e.it).titolo}</h3>
              <p class="muted dettaglio">{(e[locale] ?? e.it).dettaglio}</p>
            </li>
          ))
        }
      </ol>
    </section>
  </section>

  <style>
    .sottotitolo {
      font-size: 1.1rem;
      color: var(--text-2);
    }
    .libro-hero {
      display: grid;
      grid-template-columns: minmax(14rem, 1fr) 2fr;
      gap: var(--space-4);
      margin-top: var(--space-3);
      align-items: start;
    }
    @media (max-width: 44rem) {
      .libro-hero {
        grid-template-columns: 1fr;
      }
      .copertina {
        max-width: 16rem;
      }
    }
    .copertina {
      width: 100%;
      border-radius: var(--radius);
      border: 1px solid var(--border);
      box-shadow: 0 8px 30px rgba(0, 0, 0, 0.25);
    }
    .evento-sub {
      font-family: var(--font-display);
      font-style: italic;
      font-size: 1.15rem;
      color: var(--text-2);
    }
    .dove {
      list-style: none;
      padding: 0;
    }
    .dove li {
      margin-bottom: 0.3rem;
    }
    .blocco {
      margin-top: var(--space-4);
    }
    .cards-3 {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
      gap: var(--space-2);
    }
    .numero {
      font-family: var(--font-display);
      font-size: 2.2rem;
      color: var(--accent);
      margin-bottom: 0;
    }
    .otto {
      columns: 2;
      column-gap: var(--space-3);
      padding-left: 1.2rem;
      color: var(--text-2);
    }
    @media (max-width: 40rem) {
      .otto {
        columns: 1;
      }
    }
    .otto li {
      margin-bottom: 0.4rem;
      break-inside: avoid;
    }
    .presentazioni {
      list-style: none;
      margin: 0;
      padding: 0;
      display: grid;
      gap: var(--space-2);
    }
    .presentazioni h3 {
      margin-bottom: 0.2rem;
    }
    .dettaglio {
      margin: 0;
      font-size: 0.9rem;
    }
  </style>
</Base>
