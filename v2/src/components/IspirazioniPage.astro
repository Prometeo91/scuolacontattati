---
import Base from '../layouts/Base.astro';
import { t } from '../i18n/strings.js';
import citazioni from '../data/citazioni.json';

const { locale } = Astro.props;
const S = t(locale);
const quotes = citazioni.map((c) => c[locale] ?? c.it);

const TESTI = {
  it: {
    lead: 'Una citazione dall’Oracolo della Scuola: parole di maestri e tradizioni per accompagnare il lavoro su di sé.',
    altra: 'Un’altra citazione',
  },
  en: {
    lead: 'A quote from the School’s Oracle: words from masters and traditions to accompany the work on oneself.',
    altra: 'Another quote',
  },
};
const T = TESTI[locale] ?? TESTI.it;
---

<Base locale={locale} title={S.navInspirations} description={T.lead}>
  <section class="section container">
    <h1>{S.navInspirations}</h1>
    <p class="muted">{T.lead}</p>

    <div class="card oracolo">
      <blockquote id="oracolo-quote"></blockquote>
      <button class="btn" id="oracolo-next" type="button">{T.altra}</button>
    </div>
  </section>

  <script is:inline define:vars={{ quotes }}>
    const q = document.getElementById('oracolo-quote');
    let idx = -1;
    function mostra() {
      let n;
      do {
        n = Math.floor(Math.random() * quotes.length);
      } while (n === idx && quotes.length > 1);
      idx = n;
      const c = quotes[idx];
      q.innerHTML = '';
      q.append(document.createTextNode(c.t));
      const f = document.createElement('footer');
      f.textContent = '— ' + c.a;
      q.append(f);
    }
    document.getElementById('oracolo-next').addEventListener('click', mostra);
    mostra();
  </script>
</Base>

<style>
  .oracolo {
    max-width: var(--measure);
    margin-top: var(--space-3);
    text-align: center;
  }
  .oracolo blockquote {
    border-left: none;
    padding-left: 0;
    margin-top: var(--space-2);
    font-size: 1.3rem;
    min-height: 6rem;
  }
</style>
