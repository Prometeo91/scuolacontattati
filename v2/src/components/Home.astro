---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { t, formatDate, localePath } from '../i18n/strings.js';
import hero from '../data/hero.json';
import insegnamenti from '../data/insegnamenti.json';
import chiSiamo from '../data/chi-siamo.json';
import libro from '../data/libro.json';
import seo from '../data/seo.json';

const { locale } = Astro.props;
const S = t(locale);
const p = (path) => localePath(locale, path);

const H = hero[locale] ?? hero.it;
const I = insegnamenti[locale] ?? insegnamenti.it;
const metodo = insegnamenti.metodo[locale] ?? insegnamenti.metodo.it;
const C = chiSiamo[locale] ?? chiSiamo.it;
const L = libro[locale] ?? libro.it;
const SEO = seo[locale] ?? seo.it;

/* Le CTA della one-page puntavano ad ancore; qui puntano alle pagine. */
const CTA_HREF = { '#calendario': p('/lezioni/'), '#contatti': p('/contatti/'), '#seminario': p('/seminario/') };

const annuncioAttivo = hero.it.annuncio && new Date(hero.it.annuncio.expires + 'T23:59:59') >= new Date();
const annuncioHtml = annuncioAttivo
  ? H.annuncio.html.replace(/#seminario/g, p('/seminario/'))
  : null;

const lezioni = await getCollection('lezioni');
const oggi = new Date();
const prossima = lezioni
  .filter((l) => l.data.data && l.data.data >= oggi)
  .sort((a, b) => a.data.data - b.data.data)[0];

const TESTI = {
  it: { scopri: 'Scopri di più →', contattaci: 'Contattaci' },
  en: { scopri: 'Learn more →', contattaci: 'Contact us' },
};
const X = TESTI[locale] ?? TESTI.it;

const teaser = [
  { href: p('/chi-siamo/'), eyebrow: C.eyebrow, titolo: C.titolo, testo: C.sottotitolo },
  { href: p('/libro/'), eyebrow: L.eyebrow, titolo: libro.titolo, testo: L.sottotitolo_libro },
  {
    href: p('/giochi/'),
    eyebrow: S.navGames,
    titolo: locale === 'en' ? 'Learning by playing' : 'Imparare giocando',
    testo:
      locale === 'en'
        ? 'Free bilingual initiatic games: quizzes, scenarios and interactive adventures.'
        : 'Giochi iniziatici gratuiti e bilingui: quiz, scenari e avventure interattive.',
  },
];
---

<Base locale={locale} description={SEO.description}>
  {annuncioHtml && (
    <div class="annuncio">
      <p set:html={annuncioHtml} />
    </div>
  )}

  <section class="section hero">
    <div class="container">
      <img
        class="emblema"
        src={'/' + hero.immagini.emblema}
        alt={hero.immagini.emblema_alt}
        width="96"
        height="96"
      />
      <h1 set:html={H.titolo} />
      <p class="motto" lang="el">{H.motto}</p>
      <p class="motto-sub">{H.motto_sub}</p>
      <p class="hero-lead">{H.slogan}</p>
      <div class="cta-row">
        {
          H.cta.map((cta) => (
            <a
              class:list={['btn', { ghost: cta.stile === 'ghost' }]}
              href={CTA_HREF[cta.href] ?? cta.href}
            >
              {cta.label}
            </a>
          ))
        }
      </div>
    </div>
  </section>

  {
    prossima && (
      <section class="section">
        <div class="container">
          <p class="eyebrow">{S.nextLesson}</p>
          <a class="card next-lesson" href={p(`/lezioni/${prossima.id}/`)}>
            <h2>{prossima.data.titolo}</h2>
            <p class="muted">
              {formatDate(prossima.data.data, locale)} — {S.year} {prossima.data.anno},{' '}
              {S.lesson} {prossima.data.num}
            </p>
            <p>{prossima.data.sottotitolo}</p>
          </a>
        </div>
      </section>
    )
  }

  <section class="section">
    <div class="container">
      <p class="eyebrow">{I.eyebrow}</p>
      <h2>{I.titolo}</h2>
      <p class="muted">{I.sottotitolo}</p>
      <div class="pilastri">
        {
          insegnamenti.pilastri.map((pilastro) => {
            const P = pilastro[locale] ?? pilastro.it;
            return (
              <div class="card">
                <h3>{P.titolo}</h3>
                <ul>
                  {P.voci.map((voce) => (
                    <li>{voce}</li>
                  ))}
                </ul>
              </div>
            );
          })
        }
      </div>
      <blockquote class="metodo">
        {metodo.citazione}
        <footer>— {metodo.fonte}</footer>
      </blockquote>
      <a class="btn" href={p('/lezioni/')}>{S.ctaLessons}</a>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="teaser-grid">
        {
          teaser.map((box) => (
            <a class="card teaser" href={box.href}>
              <p class="eyebrow">{box.eyebrow}</p>
              <h3>{box.titolo}</h3>
              <p class="muted">{box.testo}</p>
              <span class="scopri">{X.scopri}</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</Base>

<style>
  .annuncio {
    background: var(--surface);
    border-bottom: 1px solid var(--border);
    text-align: center;
    padding: 0.5rem var(--space-2);
    font-size: 0.9rem;
  }
  .annuncio p {
    margin: 0;
    max-width: none;
  }
  .annuncio :global(strong) {
    color: var(--accent);
  }
  .hero {
    padding-block: var(--space-5);
    text-align: center;
  }
  .hero .container {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .emblema {
    margin-bottom: var(--space-2);
  }
  .hero h1 :global(span) {
    color: var(--accent);
  }
  .motto {
    font-family: var(--font-display);
    font-size: 1.4rem;
    color: var(--accent-2);
    letter-spacing: 0.15em;
    margin-bottom: 0.2rem;
  }
  .motto-sub {
    font-size: 0.85rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-3);
  }
  .hero-lead {
    font-size: 1.15rem;
    color: var(--text-2);
    margin-block: var(--space-2) var(--space-3);
    max-width: 44ch;
  }
  .cta-row {
    display: flex;
    gap: var(--space-2);
    flex-wrap: wrap;
    justify-content: center;
  }
  .btn.ghost {
    border-color: var(--border);
    color: var(--text-2);
  }
  [data-theme='light'] .btn.ghost {
    background: none;
  }
  .btn.ghost:hover {
    border-color: var(--accent-2);
    background: none;
    color: var(--accent);
  }
  .next-lesson {
    display: block;
    color: inherit;
    max-width: var(--measure);
  }
  .next-lesson:hover {
    text-decoration: none;
  }
  .next-lesson h2 {
    color: var(--accent);
  }
  .pilastri {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
    gap: var(--space-2);
    margin-block: var(--space-3);
  }
  .pilastri ul {
    padding-left: 1.2rem;
    color: var(--text-2);
    margin: 0;
  }
  .pilastri li {
    margin-bottom: 0.4rem;
  }
  .metodo {
    margin-block: var(--space-3);
  }
  .teaser-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: var(--space-2);
  }
  .teaser {
    display: block;
    color: inherit;
  }
  .teaser:hover {
    text-decoration: none;
  }
  .teaser h3 {
    color: var(--accent);
  }
  .scopri {
    font-size: 0.9rem;
    color: var(--accent-2);
  }
</style>
